{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Mango local entitlement fixture HTTP API",
    "version": "1.0.1-local",
    "description": "Candidate specification only; no running service, DB or chain claim. Strict JSON; max 64KiB body. localhost only; GUI deferred."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080",
      "description": "Proposed local listener, not running or deployed"
    }
  ],
  "paths": {
    "/v1/tasks/ingest": {
      "post": {
        "operationId": "ingestFixtureEvent",
        "summary": "Admit a fixed-domain local fixture event; never an arbitrary target call",
        "security": [
          {
            "LocalRoleToken": []
          }
        ],
        "x-required-role": "fixture_ingest",
        "responses": {
          "400": {
            "description": "Strict schema rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid local role token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Token lacks required role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Bounded local request quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required dependency or activation gate unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Equal key and immutable payload: return original task, retaining route snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "202": {
            "description": "New event durably admitted; target completion not implied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "409": {
            "description": "Same task key with conflicting immutable payload; no overwrite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Unknown route, unsupported revision or fixture authorization/domain rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error; no false success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{task_id}": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          },
          "description": "Canonical 0x lowercase SHA-256 task ID, not a source tx hash."
        }
      ],
      "get": {
        "operationId": "getTask",
        "summary": "Read task and freshness; dependency health does not redefine business outcome",
        "security": [
          {
            "LocalRoleToken": []
          }
        ],
        "x-required-role": "reader",
        "responses": {
          "400": {
            "description": "Strict schema rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid local role token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Token lacks required role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Bounded local request quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required dependency or activation gate unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Task state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error; no false success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{task_id}/receipt": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          },
          "description": "Canonical 0x lowercase SHA-256 task ID, not a source tx hash."
        }
      ],
      "get": {
        "operationId": "getReceipt",
        "summary": "Confirmed success or explicit pending/unavailable result",
        "security": [
          {
            "LocalRoleToken": []
          }
        ],
        "x-required-role": "reader",
        "responses": {
          "400": {
            "description": "Strict schema rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid local role token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Token lacks required role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Bounded local request quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required dependency or activation gate unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Confirmed matching target effect; successful incident keeps this result and review flag",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "202": {
            "description": "Not a success receipt; outcome still pending/unknown/manual review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingReceipt"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Rejected or source invalidated: no success receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error; no false success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{task_id}/retry": {
      "parameters": [
        {
          "name": "task_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          },
          "description": "Canonical 0x lowercase SHA-256 task ID, not a source tx hash."
        }
      ],
      "post": {
        "operationId": "requestOperatorAction",
        "summary": "Idempotent guarded action; unknown only queues reconciliation, never blind resend",
        "security": [
          {
            "LocalRoleToken": []
          }
        ],
        "x-required-role": "operator",
        "responses": {
          "400": {
            "description": "Strict schema rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid local role token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Token lacks required role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Bounded local request quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required dependency or activation gate unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Same action_id and identical body: return original ack before revision comparison",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorActionAck"
                }
              }
            }
          },
          "202": {
            "description": "Action durably accepted; target submission not implied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorActionAck"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Action ID/body conflict, revision conflict or forbidden retry phase",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error; no false success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RetryRequest"
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Local dependency/schema/activation readiness only; not task success",
        "security": [
          {
            "LocalRoleToken": []
          }
        ],
        "x-required-role": "reader",
        "responses": {
          "200": {
            "description": "All required local dependencies and schema ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Not ready; target activation may still be disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "401": {
            "description": "Missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not a reader",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error; no false success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Process alive only; no task, DB or chain completion implied",
        "security": [],
        "responses": {
          "200": {
            "description": "Alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error; no false success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "LocalRoleToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Future locally provisioned high-entropy test token mapped to explicit roles reader/operator/fixture_ingest; no tokens included. Operator does not automatically inherit reader. No public auth/identity claims."
      }
    },
    "schemas": {
      "BusinessPayload": {
        "type": "object",
        "properties": {
          "action": {
            "const": "issue_test_entitlement"
          },
          "campaign_id": {
            "type": "string",
            "pattern": "^[\\x21-\\x7e]{1,64}(?![\\s\\S])"
          },
          "entitlement_code": {
            "type": "string",
            "pattern": "^[\\x21-\\x7e]{1,64}(?![\\s\\S])"
          },
          "recipient_mango": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "action",
          "campaign_id",
          "entitlement_code",
          "recipient_mango"
        ],
        "additionalProperties": false
      },
      "SourceObservation": {
        "type": "object",
        "properties": {
          "source_genesis_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          },
          "source_contract": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}(?![\\s\\S])"
          },
          "business_event_id": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          },
          "source_transaction_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          },
          "source_block_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          },
          "source_height": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source_log_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "observed_at_unix_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "is_simulated": {
            "const": true
          },
          "evidence_label": {
            "const": "LOCAL_FIXTURE"
          },
          "emitted_payload_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "source_genesis_hash",
          "source_contract",
          "business_event_id",
          "source_transaction_hash",
          "source_block_hash",
          "source_height",
          "source_log_index",
          "observed_at_unix_ms",
          "is_simulated",
          "evidence_label",
          "emitted_payload_digest"
        ],
        "additionalProperties": false
      },
      "FixtureAuthorization": {
        "type": "object",
        "properties": {
          "mode": {
            "const": "FIXTURE_ONLY_NO_SIGNATURE"
          },
          "policy_version": {
            "const": 1
          },
          "authorization_expires_at_unix_s": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "authorization_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "mode",
          "policy_version",
          "authorization_expires_at_unix_s",
          "authorization_digest"
        ],
        "additionalProperties": false
      },
      "IngestRequest": {
        "type": "object",
        "properties": {
          "stable_route_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])"
          },
          "requested_route_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "source": {
            "$ref": "#/components/schemas/SourceObservation"
          },
          "payload": {
            "$ref": "#/components/schemas/BusinessPayload"
          },
          "fixture_authorization": {
            "$ref": "#/components/schemas/FixtureAuthorization"
          }
        },
        "required": [
          "stable_route_id",
          "requested_route_revision",
          "source",
          "payload",
          "fixture_authorization"
        ],
        "additionalProperties": false
      },
      "EvidenceItem": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}(?![\\s\\S])"
          },
          "label": {
            "enum": [
              "LOCAL_FIXTURE",
              "TRUSTED_RPC_OBSERVATION",
              "AUTHORIZED_WITNESS",
              "TARGET_CONFIRMED_EFFECT"
            ]
          },
          "is_simulated": {
            "type": "boolean"
          },
          "observed_at_unix_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "network_identity": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "reference": {
            "type": "object",
            "properties": {
              "source_event_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_transaction_hash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_block_hash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_height": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target_transaction_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target_checkpoint": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target_package_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "task_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effect_status": {
                "enum": [
                  "SUCCESS",
                  "FAILURE",
                  "UNKNOWN",
                  null
                ]
              },
              "business_payload_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target_package_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "source_event_id",
              "source_transaction_hash",
              "source_block_hash",
              "source_height",
              "target_transaction_digest",
              "target_checkpoint",
              "target_package_id",
              "task_id",
              "effect_status",
              "business_payload_digest",
              "target_package_digest"
            ],
            "additionalProperties": false
          },
          "evidence_role": {
            "enum": [
              "SOURCE",
              "AUTHORIZATION",
              "TARGET"
            ],
            "description": "Roles are checked against receipt reference lists, the evidence label and the corresponding locators by the semantic validator."
          }
        },
        "required": [
          "evidence_id",
          "label",
          "is_simulated",
          "observed_at_unix_ms",
          "network_identity",
          "reference",
          "evidence_role"
        ],
        "additionalProperties": false
      },
      "Task": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          },
          "task_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "stable_route_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}(?![\\s\\S])"
          },
          "route_revision_snapshot": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "business_payload_digest": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}(?![\\s\\S])"
          },
          "state": {
            "enum": [
              "OBSERVED",
              "WAITING_SOURCE",
